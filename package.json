{
  "name": "pi-aftercare",
  "version": "0.1.0",
  "private": true,
  "description": "Pi-based apparel returns and exchanges agent",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "check:sdk": "node --import tsx scripts/check-sdk.ts",
    "check:http": "node --import tsx scripts/check-http.ts",
    "check": "npm run typecheck && npm run check:sdk && npm run check:http && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "typebox": "1.3.27"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
