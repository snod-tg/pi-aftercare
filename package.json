{
  "name": "pi-aftercare",
  "version": "0.1.0",
  "private": true,
  "description": "Pi-based apparel returns and exchanges agent",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "chat": "node --import tsx scripts/chat.ts",
    "check:sdk": "node --import tsx scripts/check-sdk.ts",
    "check:http": "node --import tsx scripts/check-http.ts",
    "check": "npm run typecheck && npm test && npm run check:sdk && npm run check:http && npm run build",
    "db:local": "node --import tsx scripts/postgres-local.ts",
    "db:init": "node --import tsx scripts/db-init.ts",
    "test:postgres": "node --import tsx scripts/test-postgres.ts",
    "eval": "node --import tsx scripts/eval.ts",
    "check:tau": ".venv/bin/python -m pytest evals/tests -q",
    "tau:smoke": ".venv/bin/python -m evals.run_tau --smoke",
    "tau:full": ".venv/bin/python -m evals.run_tau_full",
    "dev:web": "vite",
    "build:web": "vite build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@fastify/static": "10.1.6",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "lucide-react": "1.59.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "typebox": "1.3.27"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
