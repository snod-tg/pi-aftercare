{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "biome.json",
      "package.json",
      "tsconfig*.json",
      "!tsconfig.evaluation.local.json",
      "vite.config.ts",
      "src/**",
      "scripts/**/*.ts",
      "tests/**",
      "web/**",
      "!src/evaluation/**",
      "!scripts/eval.ts",
      "!scripts/tau-worker.ts",
      "!tests/evaluation.test.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noDebugger": "error",
        "noDuplicateObjectKeys": "error"
      }
    }
  }
}
