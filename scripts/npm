#!/bin/sh
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export PATH="$project_root/.runtime/node/bin:$PATH"
if [ ! -x "$project_root/.runtime/node/bin/node" ]; then
  echo "Project Node.js runtime is missing: .runtime/node/bin/node" >&2
  exit 1
fi
cd "$project_root"
exec "$project_root/.runtime/node/bin/node" "$project_root/.runtime/node/lib/node_modules/npm/bin/npm-cli.js" "$@"
