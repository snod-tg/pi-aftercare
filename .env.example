HOST=127.0.0.1
PORT=3000

# External chat-completions-compatible API. The inference service runs independently.
# No connection is made by the offline checks or business-only demo.
MODEL_BASE_URL=http://127.0.0.1:8080/v1
MODEL_NAME=aftercare-local
MODEL_API_KEY=local
MODEL_CONTEXT_WINDOW=8192
MODEL_MAX_OUTPUT_TOKENS=1024

# Per user-message limits (not total conversation limits).
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=24
AGENT_TIMEOUT_MS=120000

# Persistent business storage (omit DATABASE_URL for the offline in-memory simulator).
# Run npm run db:local -- start to create project-local credentials automatically.
# DATABASE_URL=postgresql://aftercare:your-password@127.0.0.1:55432/pi_aftercare
DATABASE_SCHEMA=aftercare
